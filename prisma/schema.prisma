generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  SICK
  CASUAL
  PRIVILEGE
  UNPAID
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

enum CandidateStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
}

enum PayrollStatus {
  PENDING
  PROCESSED
  PAID
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  loginId       String?   @unique
  password      String
  name          String?
  role          Role      @default(EMPLOYEE)
  image         String?
  companyName   String?
  companyLogo   String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employeeProfile EmployeeProfile?
  attendance      Attendance[]
  leaveRequests   LeaveRequest[]
  payrolls        Payroll[]
  documents       Document[]
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  type      String   @default("OTHER") // PDF, IMG, etc.
  url       String   // For now, might just be a filename or simulated path
  
  createdAt DateTime @default(now())
}

model EmployeeProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  phone          String?
  address        String?
  department     String?
  position       String?
  joiningDate    DateTime?
  employeeId     String?   @unique
  dob            DateTime?
  
  // Private Info
  nationality    String?
  gender         String?
  maritalStatus  String?
  personalEmail  String?
  
  // Organizational Info
  company        String?
  manager        String?
  location       String?
  
  // Bank & Salary Info
  basicSalary    Float     @default(50000)
  accountNumber  String?
  bankName       String?
  ifscCode       String?
  panNo          String?
  uanNo          String?
  empCode        String?
  
  // Salary Structure (Admin configurable)
  monthlyWage    Float?    @default(50000)   // Base monthly wage
  yearlyWage     Float?    @default(600000)  // Calculated as monthlyWage * 12
  workingDaysPerWeek Int?  @default(5)       // For calculations
  breakTimeHours Float?    @default(1)       // Break time per day
  
  // Salary Components (Auto-calculated)
  basicPercent   Float?    @default(50)      // % of wage
  basicAmount    Float?    @default(25000)   // Auto-calculated
  
  hraPercent     Float?    @default(50)      // % of basic
  hraAmount      Float?    @default(12500)   // Auto-calculated
  
  standardAllowance Float? @default(4167)    // Fixed amount
  
  performanceBonusPercent Float? @default(8.33)  // % of wage
  performanceBonusAmount  Float? @default(4165)  // Auto-calculated
  
  ltaPercent     Float?    @default(8.333)   // % of wage
  ltaAmount      Float?    @default(4166.5)  // Auto-calculated
  
  fixedAllowance Float?    @default(0)       // Wage - total of all components
  
  // Deductions
  pfPercent      Float?    @default(12)      // PF contribution %
  pfAmount       Float?    @default(3000)    // Auto-calculated from basic
  
  professionalTax Float?   @default(200)     // Fixed amount
  
  // Employer Contributions
  employerPFPercent Float? @default(12)      // Employer PF %
  employerPFAmount  Float? @default(3000)    // Auto-calculated
  
  // Net Salary (Auto-calculated)
  grossSalary    Float?    @default(50000)   // Sum of all components
  totalDeductions Float?   @default(3200)    // PF + PT
  netSalary      Float?    @default(46800)   // Gross - Deductions
  
  // Resume
  resumeUrl      String?   // Stores resume as base64 data URL or file path
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}


model Attendance {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  date      DateTime         @default(now()) @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  status    AttendanceStatus @default(ABSENT)
  location  String?
  totalHours Float?
  
  // Break tracking
  breakStart    DateTime?
  breakEnd      DateTime?
  breakDuration Float?    // in minutes
  
  // Late arrival
  isLate        Boolean   @default(false)
  lateBy        Int?      // minutes late
  
  notes         String?
  
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, date])
}

model LeaveRequest {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  
  type      LeaveType
  startDate DateTime
  endDate   DateTime
  reason    String
  status    LeaveStatus @default(PENDING)
  isPaid    Boolean     @default(true)
  
  approvedBy String?
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Payroll {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  
  month         String
  year          Int
  basicSalary   Float
  allowances    Float         @default(0)
  deductions    Float         @default(0)
  netSalary     Float
  status        PayrollStatus @default(PENDING)
  paymentDate   DateTime?
  
  // Attendance-based calculation fields
  totalWorkingDays  Int       @default(0)
  paidLeaveDays     Int       @default(0)
  unpaidLeaveDays   Int       @default(0)
  absentDays        Int       @default(0)
  presentDays       Int       @default(0)
  payableDays       Int       @default(0)
  dailyRate         Float     @default(0)
  overtimeHours     Float     @default(0)
  overtimePay       Float     @default(0)
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model JobPosting {
  id          String      @id @default(cuid())
  title       String
  department  String
  location    String
  type        String
  description String      @db.Text
  requirements String?    @db.Text
  salaryRange String?
  status      JobStatus   @default(OPEN)
  postedDate  DateTime    @default(now())
  
  candidates  Candidate[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Candidate {
  id           String          @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting      @relation(fields: [jobPostingId], references: [id])
  
  name         String
  email        String
  phone        String?
  resumeUrl    String?
  status       CandidateStatus @default(APPLIED)
  notes        String?         @db.Text
  
  appliedDate  DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}
